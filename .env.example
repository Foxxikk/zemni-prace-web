# ---------------------------------------------------------------------------
# ODESILANI POPTAVEK (POVINNE!)
# Bez RESEND_API_KEY se poptavka v produkci NEODESLE a formular vrati chybu 503.
# ---------------------------------------------------------------------------
# 1) Zaloz ucet na https://resend.com a over domenu zemniprace-prahavychod.cz (SPF + DKIM)
# 2) Vytvor API klic a vloz ho do Hostingeru (hPanel > Node.js aplikace > Environment variables)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adresa, ze ktere se e-maily posilaji - musi byt na overene domene.
MAIL_FROM="Poptávka z webu <poptavka@zemniprace-prahavychod.cz>"

# Kam poptavky chodi. Vice adres oddel carkou.
MAIL_TO=krukbabice@gmail.com

# Verejna URL webu (sitemap, canonicaly, Open Graph).
NEXT_PUBLIC_SITE_URL=https://zemniprace-prahavychod.cz

# ---------------------------------------------------------------------------
# MERENI (GA4 + GOOGLE ADS)
# Dokud je prazdne, nenacte se zadny mericí skript ani cookie lista neni potreba.
# ---------------------------------------------------------------------------
# GA4 Measurement ID, napr. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-X0F1GY7JX5

# Google Ads conversion ID, napr. AW-123456789 (doplnit az po zalozeni Ads uctu)
NEXT_PUBLIC_GADS_ID=

# Labely jednotlivych konverznich akci z Google Ads (cast za lomitkem v send_to)
NEXT_PUBLIC_GADS_LABEL_FORM=
NEXT_PUBLIC_GADS_LABEL_TEL=
NEXT_PUBLIC_GADS_LABEL_MAIL=

# ---------------------------------------------------------------------------
# ZALOHA LEADU (doporucene)
# Webhook, kam se kazda poptavka zapise i mimo e-mail (napr. Google Apps Script
# zapisujici radky do Google Sheetu). Slouzi i jako evidence pro parovani
# leadu se ziskanymi zakazkami v Google Ads.
# ---------------------------------------------------------------------------
LEAD_WEBHOOK_URL=
