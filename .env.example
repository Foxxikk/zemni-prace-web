# Odeslání poptávek e-mailem přes Resend (https://resend.com)
# 1) Založ účet na Resend a ověř svoji doménu (DNS záznamy)
# 2) Vytvoř API klíč a vlož ho sem
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adresa, ze které se e-maily posílají (musí být na ověřené doméně)
MAIL_FROM="Poptávka webu <poptavka@vase-domena.cz>"

# Adresa, kam poptávky chodí (firemní e-mail)
MAIL_TO=krukbabice@gmail.com

# Veřejná URL webu (pro sitemap a metadata)
NEXT_PUBLIC_SITE_URL=https://www.vase-domena.cz
